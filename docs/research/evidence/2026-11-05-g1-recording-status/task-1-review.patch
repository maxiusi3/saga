+    await leaseRpc(service, f.jobId, 'claim', WORKER, null, ttl)
+    const lease = await leaseRpc(service, f.jobId, 'start', WORKER, 1)
+    f.lease = { ...lease, deadline: began + ttl - Math.min(100, ttl / 10) }
+  }
