  "fixtureSql": "CREATE ROLE metadata_reader LOGIN; CREATE ROLE anon; CREATE ROLE authenticated; CREATE ROLE service_role;\nCREATE SCHEMA storage; CREATE SCHEMA other_schema;\nREVOKE CREATE ON SCHEMA public FROM PUBLIC;\nGRANT USAGE ON SCHEMA storage TO metadata_reader, authenticated, service_role;\nCREATE FUNCTION public.fixture_default(x text DEFAULT 'SYNTHETIC_DEFAULT_VALUE') RETURNS text LANGUAGE plpgsql STRICT SECURITY DEFINER SET search_path = pg_catalog, public SET application_name = 'SYNTHETIC_PROCONFIG_VALUE' AS $$BEGIN RAISE EXCEPTION 'SYNTHETIC_BODY_VALUE'; END$$;\nCREATE FUNCTION public.fixture_revoked() RETURNS integer LANGUAGE sql AS $$SELECT 1$$;\nREVOKE ALL ON FUNCTION public.fixture_revoked() FROM PUBLIC;\nGRANT EXECUTE ON FUNCTION public.fixture_revoked() TO authenticated;\nCREATE PROCEDURE storage.fixture_procedure() LANGUAGE plpgsql AS $$BEGIN RAISE EXCEPTION 'SYNTHETIC_PROCEDURE_VALUE'; END$$;\nCREATE FUNCTION other_schema.fixture_excluded() RETURNS integer LANGUAGE sql AS $$SELECT 2$$;\nCREATE FUNCTION public.fixture_trigger() RETURNS trigger LANGUAGE plpgsql AS $$BEGIN RAISE EXCEPTION 'SYNTHETIC_TRIGGER_BODY'; END$$;\nCREATE TABLE public.fixture_rows(id text PRIMARY KEY, note text);\nCREATE TRIGGER fixture_trigger BEFORE INSERT ON public.fixture_rows FOR EACH ROW WHEN (NEW.note = 'SYNTHETIC_WHEN_VALUE') EXECUTE FUNCTION public.fixture_trigger('SYNTHETIC_ARG_VALUE');\nALTER DEFAULT PRIVILEGES FOR ROLE fixture_admin REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;\nALTER DEFAULT PRIVILEGES FOR ROLE fixture_admin REVOKE EXECUTE ON FUNCTIONS FROM fixture_admin;\nALTER DEFAULT PRIVILEGES FOR ROLE fixture_admin IN SCHEMA public GRANT SELECT ON TABLES TO authenticated;\nALTER DEFAULT PRIVILEGES FOR ROLE fixture_admin IN SCHEMA other_schema GRANT SELECT ON TABLES TO anon;\nALTER DEFAULT PRIVILEGES FOR ROLE fixture_admin GRANT USAGE ON SCHEMAS TO anon;",
